# ConsulSales environment variables.
# Copy this file to .env.local and fill it in. NEVER commit real values, and never paste them into chat.
# In production, add the same names in Vercel -> Settings -> Environment Variables (use the Secret type for secrets).
# The admin page /admin/integrations shows which of these the server can see, never their values.

# --- App ---
# public, required
NEXT_PUBLIC_APP_URL=

# --- Supabase ---
# public, required
NEXT_PUBLIC_SUPABASE_URL=
# public, required
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# secret, required
SUPABASE_SERVICE_ROLE_KEY=

# --- Whop ---
# config, required
WHOP_PLAN_STARTER=
# config, required
WHOP_PLAN_PRO=
# config, required
WHOP_PLAN_ENTERPRISE=
# secret, required
WHOP_API_KEY=
# config, required
WHOP_ACCOUNT_ID=
# secret, required
WHOP_WEBHOOK_SECRET=

# --- Resend ---
# secret, required
RESEND_API_KEY=
# config, required
EMAIL_FROM=

# --- Kickoff booking ---
# public, optional
NEXT_PUBLIC_BAZOOKA_BOOKING_LINK=
# config, optional
BOOKING_PROVIDER=
# secret, optional
BOOKING_API_KEY=
# config, optional
BOOKING_FALLBACK_URL=

# --- HubSpot ---
# config, optional
HUBSPOT_CLIENT_ID=
# secret, optional
HUBSPOT_CLIENT_SECRET=

# --- Pipedrive ---
# config, optional
PIPEDRIVE_CLIENT_ID=
# secret, optional
PIPEDRIVE_CLIENT_SECRET=

# --- Sentry ---
# public, optional
NEXT_PUBLIC_SENTRY_DSN=
# secret, optional
SENTRY_AUTH_TOKEN=

# --- Scheduled jobs ---
# secret, required
CRON_SECRET=

# --- Saving keys from this page ---
# secret, optional
VERCEL_API_TOKEN=
# config, optional
VERCEL_TEAM_ID=
